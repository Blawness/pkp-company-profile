# ─── Postgres (admin-kit / Drizzle) ──────────────────────────────────────
# Required. Neon pooled connection works with `prepare: false`.
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# ─── NextAuth v5 (admin-kit) ─────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# ─── AI generation ───────────────────────────────────────────────────────
# Server-only (do NOT use NEXT_PUBLIC_* for secrets)
PEXELS_API_KEY=your_pexels_api_key

# Google Gemini (used by /api/ai/*). Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_ai_studio_key

# Optional: shared secret for /api/ai/* server-to-server callers
# (cron jobs, scripts). When set, requests with a matching X-AI-Secret
# header bypass the admin-kit session check. Leave blank in production
# if no server-to-server callers use it.
AI_API_SECRET=

# ─── Public site config ──────────────────────────────────────────────────
# Public (safe to expose to the browser)
NEXT_PUBLIC_FORMSPREE_ID=your_formspree_id

# Used for metadata/sitemap/robots (recommended)
# Local dev: http://localhost:3000 | Production: https://www.presisikonsulindoprima.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Cloudflare R2 (admin-kit media uploads) — OPTIONAL, defer if needed ─
# Without these, the /admin/media screen renders but uploads fail.
# R2_BUCKET=
# R2_PUBLIC_URL=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_ENDPOINT=

# ─── Rate limit tuning (admin-kit-style /api/ai/* guard) ─────────────────
# AI_RATE_WINDOW_MS=3600000
# AI_RATE_MAX=10
# AI_RATE_AUTH_MAX=200